{
  "$defs": {
    "DoneEvent": {
      "additionalProperties": false,
      "description": "The turn ended. Sent once, last, unless the turn ended with an error event.",
      "properties": {
        "reason": {
          "enum": [
            "end",
            "max_tokens",
            "cancelled"
          ],
          "title": "Reason",
          "type": "string"
        },
        "steps": {
          "title": "Steps",
          "type": "integer"
        },
        "type": {
          "const": "done",
          "default": "done",
          "title": "Type",
          "type": "string"
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        }
      },
      "required": [
        "type",
        "reason",
        "usage",
        "steps"
      ],
      "title": "DoneEvent",
      "type": "object"
    },
    "ErrorEvent": {
      "additionalProperties": false,
      "description": "The turn failed. Sent once, last, instead of done.",
      "properties": {
        "code": {
          "enum": [
            "model_error",
            "internal_error"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "type": {
          "const": "error",
          "default": "error",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "code",
        "message"
      ],
      "title": "ErrorEvent",
      "type": "object"
    },
    "TextEvent": {
      "additionalProperties": false,
      "description": "A piece of the answer, in order. Concatenate them to get the text.",
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "type": {
          "const": "text",
          "default": "text",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "text"
      ],
      "title": "TextEvent",
      "type": "object"
    },
    "Usage": {
      "additionalProperties": false,
      "description": "Token counts for one model step, or summed over a turn.",
      "properties": {
        "input_tokens": {
          "default": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "thinking_tokens": {
          "default": 0,
          "title": "Thinking Tokens",
          "type": "integer"
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "thinking_tokens"
      ],
      "title": "Usage",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "done": "#/$defs/DoneEvent",
      "error": "#/$defs/ErrorEvent",
      "text": "#/$defs/TextEvent"
    },
    "propertyName": "type"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/TextEvent"
    },
    {
      "$ref": "#/$defs/DoneEvent"
    },
    {
      "$ref": "#/$defs/ErrorEvent"
    }
  ],
  "title": "AgentEvent"
}
