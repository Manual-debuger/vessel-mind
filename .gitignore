# The virtual environment and bytecode.
.venv/
__pycache__/
*.pyc

# Claude Code: personal settings, and agent worktrees, each a full
# checkout.
.claude/settings.local.json
.claude/worktrees/

# Local agent config; the committed example is config/agent.example.yaml.
config/agent.yaml

# Runtime data: the retrieval index (task ingest; rebuilt from the corpus),
# the state file (sessions, history, proposals; cannot be rebuilt), and the
# downloaded corpus tarballs and embedding models.
data/
.cache/

# The Notion MCP server, installed from deploy/notion-mcp/package-lock.json
# with npm ci; only the two package files are committed.
deploy/notion-mcp/node_modules/
